# ---------------
# VERDICT.RUN CONFIGURATION (.env.example)
# ---------------

NODE_ENV=production

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Auth & Secrets
JWT_SECRET=your_jwt_secret
DB_ENCRYPTION_KEY=32_byte_hex_string
BLIND_INDEX_SALT=32_byte_hex_string

# Database Connection (Supabase Pooling or Direct)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Mirror Service (Puppeteer-based scraper, default localhost:3099)
MIRROR_SERVICE_URL=http://localhost:3099
