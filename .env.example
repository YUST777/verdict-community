# ---------------
# VERDICT.RUN CONFIGURATION (.env.example)
# Copy to .env and set values. Required for Docker build and runtime.
# ---------------

NODE_ENV=production

# Public (required at build time for Next.js; set your production URL)
NEXT_PUBLIC_SITE_URL=https://verdict.run

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Auth & Secrets (use strong random values in production)
JWT_SECRET=your_jwt_secret
DB_ENCRYPTION_KEY=32_byte_hex_string
BLIND_INDEX_SALT=32_byte_hex_string

# Database (Supabase Pooling or Direct)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (required for Docker; must match judge0/judge0.conf REDIS_PASSWORD)
REDIS_PASSWORD=yourredispassword

# Services (Docker Compose uses internal hostnames)
MIRROR_SERVICE_URL=http://verdict-mirror:3099
JUDGE0_URL=http://verdict-judge0-server:2358
